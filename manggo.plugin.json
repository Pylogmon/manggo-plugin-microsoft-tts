{
  "manifestVersion": 1,
  "id": "edge-read-aloud-tts",
  "name": "Microsoft TTS",
  "version": "1.1.0",
  "description": "使用 Microsoft Edge「大声朗读」在线合成语音，无需 API Key。支持 Manggo 的 14 个语言选项，可选择发音人并调整语速、音调、音量和 MP3 音质。",
  "author": "Pylogmon",
  "homepage": "https://github.com/Pylogmon/manggo-plugin-microsoft-tts",
  "updateUrl": "https://raw.githubusercontent.com/Pylogmon/manggo-plugin-microsoft-tts/main/updates.json",
  "icon": "edge.svg",
  "permissions": [
    "network"
  ],
  "requires": {
    "minAppVersion": "1.3.10"
  },
  "runtime": {
    "kind": "moejs",
    "api": "manggo.plugin.v1",
    "main": "main.js"
  },
  "services": [
    {
      "id": "speech",
      "kind": "speech",
      "displayName": "Microsoft TTS",
      "entry": "tts",
      "language": {
        "auto": "auto",
        "zh_CN": "zh-CN",
        "zh_TW": "zh-TW",
        "en_US": "en-US",
        "ja_JP": "ja-JP",
        "ko_KR": "ko-KR",
        "de_DE": "de-DE",
        "fr_FR": "fr-FR",
        "es_ES": "es-ES",
        "it_IT": "it-IT",
        "pt_BR": "pt-BR",
        "pt_PT": "pt-PT",
        "ru_RU": "ru-RU",
        "uk_UA": "uk-UA",
        "vi_VN": "vi-VN"
      },
      "config": [
        {
          "key": "autoLanguage",
          "label": "未指定语言时使用",
          "control": "select",
          "default": "auto",
          "description": "仅在 Manggo 不提供语言时使用，例如划词快捷键朗读。",
          "options": [
            {
              "label": "自动判断",
              "value": "auto"
            },
            {
              "label": "简体中文",
              "value": "zh-CN"
            },
            {
              "label": "繁体中文",
              "value": "zh-TW"
            },
            {
              "label": "英语（美国）",
              "value": "en-US"
            },
            {
              "label": "日语",
              "value": "ja-JP"
            },
            {
              "label": "韩语",
              "value": "ko-KR"
            },
            {
              "label": "德语",
              "value": "de-DE"
            },
            {
              "label": "法语",
              "value": "fr-FR"
            },
            {
              "label": "西班牙语",
              "value": "es-ES"
            },
            {
              "label": "意大利语",
              "value": "it-IT"
            },
            {
              "label": "葡萄牙语（巴西）",
              "value": "pt-BR"
            },
            {
              "label": "葡萄牙语（葡萄牙）",
              "value": "pt-PT"
            },
            {
              "label": "俄语",
              "value": "ru-RU"
            },
            {
              "label": "乌克兰语",
              "value": "uk-UA"
            },
            {
              "label": "越南语",
              "value": "vi-VN"
            }
          ]
        },
        {
          "key": "voiceZhCN",
          "label": "简体中文发音人",
          "control": "select",
          "default": "zh-CN-XiaoxiaoNeural",
          "options": [
            {
              "label": "晓晓（女声）",
              "value": "zh-CN-XiaoxiaoNeural"
